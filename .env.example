# Groq API — console.groq.com (Crisp live chat backend)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API — aistudio.google.com (NP AI chat widget)
GEMINI_API_KEY=your_gemini_api_key_here

# Crisp Website ID (already in index.html, but keep here for reference)
CRISP_WEBSITE_ID=3377d9c1-4785-497e-b676-bc91178e0219

# Crisp API — Crisp Dashboard → Profile → Account → API Tokens
# Create a new token and copy both the Identifier and Key
CRISP_API_IDENTIFIER=your_crisp_api_identifier
CRISP_API_KEY=your_crisp_api_key
