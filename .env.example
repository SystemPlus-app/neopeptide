# SMTP2GO API — smtp2go.com (order notification email)
SMTP2GO_API_KEY=your_smtp2go_api_key_here
SMTP2GO_SENDER=Neo Peptide USA <Support@neopeptideus.com>

# Resend API — resend.com (fallback transactional email)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Neo Peptide USA <orders@neopeptideus.com>
RESEND_REPLY_TO=Support@neopeptideus.com

# Internal notification recipients
# Use comma-separated emails for multiple people.
ORDER_TO_EMAIL=Support@neopeptideus.com
CONTACT_TO_EMAIL=Support@neopeptideus.com
